{
    "layer": "top",
    "position": "top",
    "spacing": 0,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,
    "margin-bottom": 4,

    "modules-left": [
        "custom/powerstatus",
        "custom/separator",
    "hyprland/window",
        "custom/separator",
        "custom/tempstatus",
        "custom/separator",
        "memory",
        "custom/separator",
        "cpu"
    ],

    "modules-center": [
        "custom/time_left",
        "hyprland/workspaces",
        "custom/time_right"
    ],

    "modules-right": [
	"tray",
        "custom/separator",
        "network",
        "custom/separator",
        "bluetooth",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "clock",
        "custom/separator",
        "custom/clipboard",
        "custom/separator",
        "custom/power"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate",
        "format-icons": {
            "1": "󰲠",
            "2": "󰲢",
            "3": "󰲤",
            "4": "󰲦",
            "5": "󰲨",
            "6": "󰲪",
            "7": "󰲬",
            "8": "󰲮",
            "9": "󰲰",
            "urgent": "󱐋",
            "active": "󰮯",
            "default": "󰊠"
        },
        "sort-by-number": true,
        "persistent-workspaces": {
            "*": [1, 2, 3, 4]
        }
    },

    "hyprland/window": {
        "format": "{title}",
        "max-length": 25,
        "separate-outputs": true,
        "rewrite": {
            "(.*) — Mozilla Firefox": "󰈹  $1",
            "(.*)Mozilla Firefox": "󰈹  Firefox",
            "(.*) - Visual Studio Code": "󰨞  $1",
            "(.*)Visual Studio Code": "󰨞  VS Code",
            "(.*)Alacritty": "  Terminal",
            "(.*)kitty": "  Terminal",
            "(.*)Thunar": "󰉋  Files"
        }
    },

    "clock": {
        "format": "  {:%H:%M}",
        "format-alt": "󰃭  {:%a, %d %b %Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "year",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#ff79c6'><b>{}</b></span>",
                "days": "<span color='#bd93f9'>{}</span>",
                "weeks": "<span color='#ff5555'><b>W{}</b></span>",
                "weekdays": "<span color='#50fa7b'><b>{}</b></span>",
                "today": "<span color='#ff5555'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    "network": {
        "format-wifi": "󰤨  {essid}",
        "format-ethernet": "󰈀  {ifname}",
        "format-disconnected": "󰤭  No Signal",
        "format-linked": "󰈁  {ifname}",
        "tooltip-format": "󰤨  {essid}\n󰩟  {ipaddr}/{cidr}\n󰕒  {bandwidthUpBytes}\n󰇚  {bandwidthDownBytes}",
        "tooltip-format-ethernet": "󰈀  {ifname}\n󰩟  {ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "max-length": 20,
        "on-click": "sh -c 'command -v ghostty >/dev/null && ghostty -e nmtui || command -v kitty >/dev/null && kitty -e nmtui || alacritty -e nmtui'"
    },

    "pulseaudio": {
        "format": "{icon}  {volume}%",
        "format-bluetooth": "󰂯  {volume}%",
        "format-bluetooth-muted": "󰂲  Muted",
        "format-muted": "󰝟  Muted",
        "format-source": "󰍬  {volume}%",
        "format-source-muted": "󰍭",
        "format-icons": {
            "headphone": "󰋋",
            "hands-free": "󰋎",
            "headset": "󰋎",
            "phone": "󰏲",
            "portable": "󰏲",
            "car": "󰄋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +1%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -1%"
    },

    "cpu": {
        "format": "󰻠  {usage}%",
        "tooltip": false,
        "interval": 2,
        "on-click": "sh -c 'TERM_CMD=\"ghostty\"; command -v ghostty >/dev/null || TERM_CMD=\"kitty\"; command -v kitty >/dev/null || TERM_CMD=\"alacritty\"; command -v btm >/dev/null && $TERM_CMD -e btm || $TERM_CMD -e htop'"
    },

    "temperature": {
        "critical-threshold": 80,
        "format": "{icon}  {temperatureC}°C",
        "format-icons": ["󰔄", "󰔄", "󰔄"],
        "tooltip": false
    },

    "memory": {
        "format": "󰍛  {percentage}%",
        "tooltip-format": "RAM: {used:0.1f}G / {total:0.1f}G\nSWAP: {swapUsed:0.1f}G / {swapTotal:0.1f}G",
        "interval": 3,
        "on-click": "sh -c 'TERM_CMD=\"ghostty\"; command -v ghostty >/dev/null || TERM_CMD=\"kitty\"; command -v kitty >/dev/null || TERM_CMD=\"alacritty\"; command -v btm >/dev/null && $TERM_CMD -e btm || $TERM_CMD -e htop'"
    },

    "tray": {
        "icon-size": 14,
        "spacing": 8
    },

    "custom/logo": {
        "format": "  ",
        "tooltip": false,
        "on-click": "rofi -show drun"
    },

    "custom/separator": {
        "format": "|",
        "tooltip": false
    },

    "custom/time_left": {
        "format": "◤",
        "tooltip": false
    },

    "custom/time_right": {
        "format": "◥",
        "tooltip": false
    },

    "custom/power": {
        "format": "⏻",
        "tooltip": false,
        "on-click": "bash -c 'echo -e \"  Shutdown\\n  Reboot\\n  Logout\\n  Suspend\" | rofi -dmenu -p \"⏻ Power\" -theme-str \"window {width: 200px;}\" | awk \"{print \\$2}\" | xargs -I{} bash -c \"if [ {} = Shutdown ]; then systemctl poweroff; elif [ {} = Reboot ]; then systemctl reboot; elif [ {} = Logout ]; then hyprctl dispatch exit; elif [ {} = Suspend ]; then systemctl suspend; fi\"'"
    },

    "custom/media": {
        "format": "󰝚  {}",
        "max-length": 15,
        "exec": "playerctl metadata --format '{{artist}} — {{title}}' 2>/dev/null || echo 'No Media'",
        "on-click": "playerctl play-pause",
        "on-scroll-up": "playerctl next",
        "on-scroll-down": "playerctl previous",
        "interval": 3
    },

    "bluetooth": {
        "format": " {status}",
        "format-connected": " {device_alias}",
        "tooltip-format": "{controller_alias}\n{num_connections} connected",
        "on-click": "blueman-manager",
        "on-click-right": "bluetoothctl power toggle"
    },

    "custom/powerstatus": {
        "format": "  {}",
        "exec": "~/.config/hypr/waybar/power-status.sh",
        "interval": 5
    },

    "custom/tempstatus": {
        "exec": "~/.config/hypr/waybar/temp-status.sh",
        "interval": 5
    },

    "custom/clipboard": {
        "format": "󰅌 ",
        "tooltip": true,
        "on-click": "cursor-clip"
    }
}
